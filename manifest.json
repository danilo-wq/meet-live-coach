{
  "manifest_version": 3,
  "name": "Meet Live Coach",
  "version": "0.1.0",
  "description": "Transcrição em tempo real do Google Meet separada por participante, com dicas de coaching baseadas em um playbook de vendas.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "tabCapture",
    "offscreen"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.openai.com/*",
    "https://*.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.together.ai/*",
    "https://api.minimaxi.chat/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content/meet-coach.js"],
      "css": ["src/content/meet-coach.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html", "src/offscreen/offscreen.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ],

  "action": {
    "default_title": "Meet Live Coach",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
